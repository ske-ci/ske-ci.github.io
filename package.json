  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ske-ci/ske-ci.github.io"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "astro build",
    "check": "pnpm sync && tsc --noEmit --runExternalCode && biome ci . && pnpm i18n:check",
    "dev": "astro dev",
    "fix": "pnpm sync && biome check --write . && biome format --write .",
    "i18n:check": "node scripts/check-i18n.ts",
    "preview": "astro preview",
    "prod": "pnpm check && pnpm build",
    "pwa:icons": "./scripts/generate-icons.sh",
    "sync": "astro sync",
    "upgrade": "pnpm dlx @astrojs/upgrade"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@biomejs/biome": "^2.6.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vite-pwa/astro": "^1.2.0",
    "pwa-asset-generator": "^8.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.1.0-beta",
    "workbox-window": "^7.4.1"
  }
}
