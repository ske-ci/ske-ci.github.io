  "description": "Personal website, documentation, and technical knowledge base.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ske-ci.github.io",
  "author": {
    "name": "Sigui Kessé Emmanuel",
    "email": "ske.ci@proton.me",
