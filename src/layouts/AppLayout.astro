---
import { pwaAssetsHead } from 'virtual:pwa-assets/head';
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/app.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import Preloader from '../components/Preloader.astro';
import ReloadPrompt from '../components/ReloadPrompt.astro';
import { app } from '../config';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  animate?: 'fade' | 'initial' | 'slide' | 'none';
  transitions?: 'animate' | 'swap' | 'none';
  cssClass?: string | undefined;
  data?: string | undefined;
  rootId?: string | undefined;
  bodyId?: string | undefined;
}

const {
  title,
  description = 'The personal website of Sigui Kessé Emmanuel',
  animate = 'fade',
  transitions = 'animate',
  rootId = 'root',
  bodyId = 'app',
} = Astro.props;

const { locale } = Astro.locals;

let {
  cssClass = 'antialiased noise bg-[#fef9f2] dark:bg-[#040711] bg-gradient-to-b from-[#070617] via-[#070922] to-[#0b0720] min-h-screen w-full font-sans text-slate-100 relative overflow-x-hidden flex flex-col selection:bg-ske-500/60 selection:text-white',
  data,
} = Astro.props;

data = data
  ? `{ transitioning: false, ' ${data.replace('{', '')}`
  : '{ transitioning: false }';
---

<!DOCTYPE html>
<html
  lang={locale}
  transition:animate={animate}
  class="scroll-smooth no-scrollbar h-full w-full select-none touch-manipulation"
  id={ rootId }
  >
	<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover,shrink-to-fit=no"/>
    <meta name="description" property="og:description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{(process.env.APP_NAME || app.title) + (title ? ` | ${title}` : '')}</title>

    <link rel="mask-icon" href="/favicon.svg" color="#FFFFFF">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="msapplication-TileColor" content="#FFFFFF">
    <meta name="theme-color" content="#ffffff">

    <ClientRouter fallback={transitions} transition:persist />

    <link rel="alternate" type="application/rss+xml" title="Flux RSS de SIGUI Kessé Emmanuel" href="/rss.xml" />

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{app.name}">

    <meta name="author" content="Emmanuel SIGUI" />
    <link rel="canonical" href="{app.url}" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Emmanuel Kessé SIGUI — Software Architect & Platform Engineer" />
    <meta
        property="og:description"
        content="Building the future of the open web through open-source software, developer tools, and high-performance backend platforms."
    />
    <meta property="og:url" content="{app.url}" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Emmanuel Kessé SIGUI — Software Architect" />
    <meta
        name="twitter:description"
        content="Senior Software Architect & Platform Engineer designing backend systems and developer tools."
    />
