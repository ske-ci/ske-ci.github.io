---
import { getCVData } from '../../data/cv';
import type { Locale, ProfileId } from '../../domain/cv/types';
import {
  generateCVVariantSegments,
  generateCVVariants,
  resolveCV,
  resolveCVVariant,
} from '../../data/cv/resolver';
import { type CVTemplate, templates } from '../../templates/cv';

export function getStaticPaths() {
  const variants = generateCVVariants();

  const paths = new Map<
    string,
    {
      params: {
        variant?: string;
      };
      props: {
        locale: Locale;
        profile: ProfileId;
        template: CVTemplate;
      };
    }
  >();

  for (const variant of variants) {
    const combinations = generateCVVariantSegments(variant);

    for (const segments of combinations) {
      const resolved = resolveCVVariant(segments);

      const key = segments.join('/');

      if (paths.has(key)) {
        continue;
      }

      paths.set(key, {
        params: {
          variant: segments.length > 0 ? segments.join('/') : undefined,
        },
        props: {
          locale: resolved.locale,
          profile: resolved.profile,
          template: resolved.template,
        },
      });
    }
  }

  return [...paths.values()];
}

interface Props {
  locale: Locale;
  profile: ProfileId;
  template: CVTemplate;
}

const { locale, profile, template } = Astro.props as Props;

const { data } = getCVData(profile, locale);

const cv = resolveCV(profile, locale);

const Template = templates[template];

if (!Template) {
  throw new Error(`Unknown CV template: ${template}`);
}
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{data.title}</title>

    <meta
      name="description"
      content={data.tagline}
    />
  </head>

  <body>
    <Template cv={cv} />
  </body>
</html>
