---
import type { ResolvedCV } from '../../domain/cv/types';

interface Props {
  cv: ResolvedCV;
}

const { cv } = Astro.props;
---

<main class="cv cv--default">
  <header class="cv-header">
    <div>
      <h1>{cv.identity.name}</h1>
      <p>{cv.identity.role}</p>
      <p>{cv.identity.subtitle}</p>
    </div>

    <div class="cv-contact">
      <a href={`mailto:${cv.contact.email}`}>
        {cv.contact.email}
      </a>

      <a href={cv.contact.webUrl}>
        {cv.contact.web}
      </a>

      <a href={cv.contact.githubUrl}>
        {cv.contact.github}
      </a>

      <a href={cv.contact.linkedinUrl}>
        {cv.contact.linkedin}
      </a>
    </div>
  </header>

  <section>
    <p>{cv.identity.tagline}</p>
    <p set:html={cv.identity.summary} />
  </section>

  <section>
    <h2>Capabilities</h2>

    <div>
      {
        cv.capabilities.map((capability) => (
          <article>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Experience</h2>

    {
      cv.experiences.map((experience) => (
        <article>
          <header>
            <h3>{experience.role}</h3>
            <p>{experience.company}</p>
            <time>{experience.period}</time>
          </header>

          <p>{experience.subtitle}</p>

          <ul>
            {
              experience.impacts.map((impact) => (
                <li set:html={impact} />
              ))
            }
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Technical Expertise</h2>

    {
      cv.ecosystem.map((group) => (
        <article>
          <h3>{group.categoryLabel}</h3>

          <ul>
            {
              group.skills.map((skill) => (
                <li>{skill}</li>
              ))
            }
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Education</h2>

    {
      cv.education.map((education) => (
        <article>
          <h3>{education.degree}</h3>
          <p>{education.institution}</p>
          <time>{education.period}</time>
        </article>
      ))
    }
  </section>

  <footer>
    <p>{cv.languages}</p>
  </footer>
</main>
